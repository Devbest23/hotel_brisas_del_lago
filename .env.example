# ─────────────────────────────────────────────────────────────────────────────
# Configuración pública del sitio.
# IMPORTANTE: todo lo que empiece con VITE_ termina en el bundle del navegador.
# Nunca pongas aquí secretos (claves privadas, tokens, contraseñas).
# Copia este archivo como `.env` y ajusta los valores.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio SIN barra final. Se usa en canonical, sitemap.xml y Open Graph.
VITE_SITE_URL=https://TU-USUARIO.github.io/Hotel_Brisas_Del_Lago

# Ruta base de despliegue. En GitHub Pages (sitio de proyecto) es "/nombre-del-repo/".
# En desarrollo local se puede dejar "/".
VITE_BASE=/

# Número de WhatsApp en formato internacional, solo dígitos (Venezuela = 58 + 10 dígitos).
VITE_WHATSAPP_NUMBER=584140000000

# Correo que recibe las solicitudes de reserva.
VITE_CONTACT_EMAIL=reservas@brisasdellago.com

# (Opcional) ID de tu formulario de Formspree (https://formspree.io) para enviar
# solicitudes por correo sin backend. Si está vacío, se usa el enlace mailto.
VITE_FORMSPREE_ID=

# (Opcional, SOLO QA) "true" = la capa de datos simulada lanza un error a propósito
# para demostrar el estado de error con botón "Reintentar".
VITE_MOCK_FORCE_ERROR=false
